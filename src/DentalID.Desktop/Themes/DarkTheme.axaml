<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         DentalID — Modern Zinc Dark Theme Override
         A sleek, high-contrast Vercel/Tailwind-inspired dark aesthetic.
    ═══════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds ───────────────────────────────────── -->
    <SolidColorBrush x:Key="SurfaceDeepBrush"     Color="#09090B"/>  <!-- Zinc 950 -->
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#18181B"/>  <!-- Zinc 900 -->
    <SolidColorBrush x:Key="SurfaceFloatingBrush" Color="#27272A"/>  <!-- Zinc 800 -->
    <SolidColorBrush x:Key="SurfaceBgBrush"       Color="#09090B"/>
    <SolidColorBrush x:Key="CardBgBrush"          Color="#18181B"/>
    <SolidColorBrush x:Key="InputBgBrush"         Color="#09090B"/>
    <SolidColorBrush x:Key="PageBgBrush"          Color="#09090B"/>
    <SolidColorBrush x:Key="SidebarBgBrush"       Color="#E609090B"/> <!-- Translucent Zinc 950 -->

    <!-- ── Overlays & Shadows ────────────────────────────── -->
    <SolidColorBrush x:Key="OverlayHoverBrush"    Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayPressedBrush"  Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="OverlaySubtleBrush"   Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="OverlayStrongBrush"   Color="#B3000000"/>
    <SolidColorBrush x:Key="OverlayModerateBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="ShadowBrush"          Color="#80000000"/>
    <SolidColorBrush x:Key="NeonGlowBrush"        Color="#333B82F6"/>

    <!-- ── Accent Colors ─────────────────────────────────── -->
    <Color x:Key="AccentPrimaryColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentPrimaryBrush"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush"   Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush"      Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentTertiaryBrush"       Color="#A855F7"/>
    <SolidColorBrush x:Key="AccentBlueBrush"           Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentBlueDarkBrush"       Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentRedBrush"            Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentOrangeBrush"         Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentPurpleBrush"         Color="#A855F7"/>
    <SolidColorBrush x:Key="AccentGreenBrush"          Color="#10B981"/>

    <!-- ── Functional Status ─────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush"           Color="#EF4444"/>
    <SolidColorBrush x:Key="ForensicWarningBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ForensicSuccessBrush" Color="#10B981"/>

    <!-- ── Text ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#71717A"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="#52525B"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF"/>

    <!-- ── Borders ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderPrimaryBrush"   Color="#27272A"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"    Color="#18181B"/>
    <SolidColorBrush x:Key="BorderSecondaryBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="BorderFocusBrush"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="BorderInputBrush"     Color="#27272A"/>

    <!-- ── Navigation ───────────────────────────────────── -->
    <SolidColorBrush x:Key="NavItemHoverBrush"        Color="#27272A"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="NavItemSelectedTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavItemTextBrush"         Color="#A1A1AA"/>
    <SolidColorBrush x:Key="NavItemHoverTextBrush"    Color="#FAFAFA"/>

</ResourceDictionary>