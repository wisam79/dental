<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         DentalID — Modern Zinc Light Theme Override
         A clean, high-contrast Vercel/Tailwind-inspired light aesthetic.
    ═══════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds ───────────────────────────────────── -->
    <SolidColorBrush x:Key="SurfaceDeepBrush"     Color="#F4F4F5"/>  <!-- Zinc 100 -->
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF"/>  <!-- White -->
    <SolidColorBrush x:Key="SurfaceFloatingBrush" Color="#FFFFFF"/>  
    <SolidColorBrush x:Key="SurfaceBgBrush"       Color="#FAFAFA"/>  <!-- Zinc 50 -->
    <SolidColorBrush x:Key="CardBgBrush"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PageBgBrush"          Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SidebarBgBrush"       Color="#E6FFFFFF"/> <!-- Translucent White -->

    <!-- ── Overlays & Shadows ────────────────────────────── -->
    <SolidColorBrush x:Key="OverlayHoverBrush"    Color="#0F000000"/>
    <SolidColorBrush x:Key="OverlayPressedBrush"  Color="#1A000000"/>
    <SolidColorBrush x:Key="OverlaySubtleBrush"   Color="#08000000"/>
    <SolidColorBrush x:Key="OverlayStrongBrush"   Color="#80000000"/>
    <SolidColorBrush x:Key="OverlayModerateBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="ShadowBrush"          Color="#1A000000"/>
    <SolidColorBrush x:Key="NeonGlowBrush"        Color="#403B82F6"/>

    <!-- ── Accent Colors ─────────────────────────────────── -->
    <Color x:Key="AccentPrimaryColor">#2563EB</Color> <!-- Blue 600 -->
    <SolidColorBrush x:Key="AccentPrimaryBrush"        Color="#2563EB"/> 
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush"   Color="#1D4ED8"/> <!-- Blue 700 -->
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#1E40AF"/> <!-- Blue 800 -->
    <SolidColorBrush x:Key="AccentSecondaryBrush"      Color="#1D4ED8"/> 
    <SolidColorBrush x:Key="AccentTertiaryBrush"       Color="#9333EA"/> <!-- Purple 600 -->
    <SolidColorBrush x:Key="AccentBlueBrush"           Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentBlueDarkBrush"       Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentRedBrush"            Color="#DC2626"/> <!-- Red 600 -->
    <SolidColorBrush x:Key="AccentOrangeBrush"         Color="#D97706"/> <!-- Amber 600 -->
    <SolidColorBrush x:Key="AccentPurpleBrush"         Color="#9333EA"/>
    <SolidColorBrush x:Key="AccentGreenBrush"          Color="#059669"/> <!-- Emerald 600 -->

    <!-- ── Functional Status ─────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush"         Color="#059669"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="#D97706"/>
    <SolidColorBrush x:Key="ErrorBrush"           Color="#DC2626"/>
    <SolidColorBrush x:Key="ForensicWarningBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ForensicSuccessBrush" Color="#059669"/>

    <!-- ── Text ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#09090B"/> <!-- Zinc 950 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52525B"/> <!-- Zinc 600 -->
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#71717A"/> <!-- Zinc 500 -->
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="#A1A1AA"/> <!-- Zinc 400 -->
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF"/>

    <!-- ── Borders ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderPrimaryBrush"   Color="#E4E4E7"/> <!-- Zinc 200 -->
    <SolidColorBrush x:Key="BorderSubtleBrush"    Color="#F4F4F5"/> <!-- Zinc 100 -->
    <SolidColorBrush x:Key="BorderSecondaryBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="BorderFocusBrush"     Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderInputBrush"     Color="#E4E4E7"/>

    <!-- ── Navigation ───────────────────────────────────── -->
    <SolidColorBrush x:Key="NavItemHoverBrush"        Color="#F4F4F5"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush"     Color="#2563EB"/>
    <SolidColorBrush x:Key="NavItemSelectedTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavItemTextBrush"         Color="#52525B"/>
    <SolidColorBrush x:Key="NavItemHoverTextBrush"    Color="#09090B"/>

</ResourceDictionary>