<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DentalID.Desktop.ViewModels"
             xmlns:viewcontrols="using:DentalID.Desktop.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="DentalID.Desktop.Views.ImageComparisonView"
             x:DataType="vm:ImageComparisonViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- ══════ PAGE HEADER ══════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Classes="display" Text="{DynamicResource Str_Nav_Comparison}" Margin="0,0,0,8"/>
                <TextBlock Text="Compare evidence and records side-by-side with high precision." Classes="caption" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border IsVisible="{Binding IsOverlayMode}" Background="{DynamicResource SurfaceFloatingBrush}" Padding="12,6" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{StaticResource IconEye}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Opacity" Classes="label" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding OverlayOpacity}" Width="120" VerticalAlignment="Center" Classes="modern"/>
                    </StackPanel>
                </Border>
                
                <ToggleSwitch OnContent="Overlay" OffContent="Split" IsChecked="{Binding IsOverlayMode}" VerticalAlignment="Center"/>
                <Button Classes="outline icon" Command="{Binding SwapImagesCommand}" ToolTip.Tip="Swap Images" Padding="10">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                </Button>
                <Button Classes="primary" Command="{Binding RunComparisonCommand}" VerticalAlignment="Center" IsEnabled="{Binding !IsAnalyzing}" Padding="20,10">
                    <Button.Content>
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsAnalyzing}">
                                <PathIcon Data="{StaticResource IconMatching}" Width="16" Height="16"/>
                                <TextBlock Text="Run Comparison" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAnalyzing}" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="16" Height="16"/>
                                <TextBlock Text="Analyzing..." FontWeight="Bold"/>
                            </StackPanel>
                        </Panel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Comparison Area -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 320">
            <!-- LEFT: Comparison Viewer -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <!-- OVERLAY MODE -->
                <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding IsOverlayMode}" Background="{DynamicResource SurfaceFloatingBrush}">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Overlay Header -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid ColumnDefinitions="*, *, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Image 1 (Base)" Classes="label" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Image1Info}" Classes="caption mono" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Image 2 (Overlay)" Classes="label" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Image2Info}" Classes="caption mono" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="outline" Content="Load Base" Command="{Binding LoadImage1Command}" Padding="12,6"/>
                                    <Button Classes="outline" Content="Load Overlay" Command="{Binding LoadImage2Command}" Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Overlay Viewer Area -->
                        <Grid Grid.Row="1" Background="#050505" ClipToBounds="True">
                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding Image1Path, Converter={x:Static ObjectConverters.IsNull}}">
                                <Border Width="90" Height="90" CornerRadius="45" Background="#103B82F6" BorderBrush="#303B82F6" BorderThickness="1">
                                    <PathIcon Data="{StaticResource IconImage}" Width="36" Height="36" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Load Image 1 to begin overlay" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <viewcontrols:AdvancedImageViewer IsVisible="{Binding Image1Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <viewcontrols:AdvancedImageViewer.InnerContent>
                                    <Grid>
                                        <Image Source="{Binding Image1Path, Converter={x:Static vm:BitmapAssetValueConverter.Instance}}" Stretch="Uniform"/>
                                        <Image Source="{Binding Image2Path, Converter={x:Static vm:BitmapAssetValueConverter.Instance}}" Stretch="Uniform" Opacity="{Binding OverlayOpacity}" IsVisible="{Binding Image2Path, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Grid>
                                </viewcontrols:AdvancedImageViewer.InnerContent>
                            </viewcontrols:AdvancedImageViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SPLIT MODE -->
                <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding !IsOverlayMode}" Background="{DynamicResource SurfaceFloatingBrush}">
                    <Grid ColumnDefinitions="*, 2, *">
                        <!-- Left Side (Image 1) -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Image 1" Classes="label" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Image1Info}" Classes="caption mono" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="outline" Content="Load File..." Command="{Binding LoadImage1Command}" VerticalAlignment="Center" Padding="12,6"/>
                                </Grid>
                            </Border>
                            
                            <Grid Grid.Row="1" Background="#050505" ClipToBounds="True">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding Image1Path, Converter={x:Static ObjectConverters.IsNull}}">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#103B82F6" BorderBrush="#303B82F6" BorderThickness="1">
                                        <PathIcon Data="{StaticResource IconImage}" Width="32" Height="32" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No image loaded" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <viewcontrols:AdvancedImageViewer IsVisible="{Binding Image1Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <viewcontrols:AdvancedImageViewer.InnerContent>
                                        <Image Source="{Binding Image1Path, Converter={x:Static vm:BitmapAssetValueConverter.Instance}}" Stretch="Uniform"/>
                                    </viewcontrols:AdvancedImageViewer.InnerContent>
                                </viewcontrols:AdvancedImageViewer>
                            </Grid>
                        </Grid>

                        <!-- Center Divider -->
                        <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}"/>

                        <!-- Right Side (Image 2) -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *">
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Image 2" Classes="label" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Image2Info}" Classes="caption mono" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="outline" Content="Load File..." Command="{Binding LoadImage2Command}" Padding="12,6"/>
                                </Grid>
                            </Border>
                            
                            <Grid Grid.Row="1" Background="#050505" ClipToBounds="True">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding Image2Path, Converter={x:Static ObjectConverters.IsNull}}">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#103B82F6" BorderBrush="#303B82F6" BorderThickness="1">
                                        <PathIcon Data="{StaticResource IconImage}" Width="32" Height="32" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No image loaded" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <viewcontrols:AdvancedImageViewer IsVisible="{Binding Image2Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <viewcontrols:AdvancedImageViewer.InnerContent>
                                        <Image Source="{Binding Image2Path, Converter={x:Static vm:BitmapAssetValueConverter.Instance}}" Stretch="Uniform"/>
                                    </viewcontrols:AdvancedImageViewer.InnerContent>
                                </viewcontrols:AdvancedImageViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Results Panel -->
            <Border Grid.Column="1" Classes="card" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Comparison Results" Classes="h3" Margin="0,0,0,16"/>
                    
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="24">
                            <!-- Show when empty -->
                            <StackPanel Spacing="8" IsVisible="{Binding ComparisonResults, Converter={x:Static ObjectConverters.IsNull}}">
                                <Border Height="100" CornerRadius="8" Background="{DynamicResource SurfaceFloatingBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <TextBlock Text="Run comparison to see results" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Show when results exist -->
                            <StackPanel Spacing="24" IsVisible="{Binding ComparisonResults, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- Similarity Score -->
                                <Border Classes="card-compact" Background="{DynamicResource OverlaySubtleBrush}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="Similarity Score" Classes="label" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SimilarityScore, StringFormat='{}{0:P1}'}" Classes="h1" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stats -->
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Matched" Classes="caption"/>
                                        <TextBlock Text="{Binding ComparisonResults.MatchedTeethCount}" Classes="h2" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Different" Classes="caption"/>
                                        <TextBlock Text="{Binding ComparisonResults.DifferentTeethCount}" Classes="h2" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Separator/>

                                <!-- Difference Highlights -->
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconInfo}" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="Key Differences" Classes="h4"/>
                                    </StackPanel>
                                    
                                    <ItemsControl ItemsSource="{Binding DifferenceHighlights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="card-compact" Margin="0,0,0,8" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="3,0,0,0" CornerRadius="0,4,4,0">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="caption"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <TextBlock Text="No significant differences found." Classes="caption" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !DifferenceHighlights.Count}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>