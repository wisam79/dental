<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DentalID.Desktop.Views"
        xmlns:vm="using:DentalID.Desktop.ViewModels"
        x:Class="DentalID.Desktop.Views.SplashWindow"
        x:DataType="vm:StartupViewModel"
        Width="1140" Height="700"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Topmost="False"
        Opacity="0"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
        </Transitions>
    </Window.Transitions>

    <Grid>
        <!-- Immersive Modern Ambient Glow Background -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <!-- Top Left Primary Blue Glow -->
            <Ellipse Width="800" Height="800" Canvas.Left="-300" Canvas.Top="-350" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="70%" RadiusY="70%">
                        <GradientStop Offset="0.0" Color="#2A3B82F6"/> <!-- Tailwind Blue 500 -->
                        <GradientStop Offset="0.5" Color="#0D3B82F6"/>
                        <GradientStop Offset="1.0" Color="#003B82F6"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Bottom Right Secondary Purple Glow -->
            <Ellipse Width="650" Height="650" Canvas.Right="-200" Canvas.Bottom="-250" Opacity="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="70%" RadiusY="70%">
                        <GradientStop Offset="0.0" Color="#2AA855F7"/> <!-- Tailwind Purple 500 -->
                        <GradientStop Offset="0.5" Color="#0DA855F7"/>
                        <GradientStop Offset="1.0" Color="#00A855F7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Center subtle structural highlight -->
            <Ellipse Width="500" Height="500" Canvas.Left="300" Canvas.Top="100" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="70%" RadiusY="70%">
                        <GradientStop Offset="0.0" Color="#3A10B981"/> <!-- Tailwind Emerald 500 -->
                        <GradientStop Offset="1.0" Color="#0010B981"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Deeply shadowed card container -->
        <Border Margin="24"
                CornerRadius="24"
                ClipToBounds="True"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBgBrush}"
                BoxShadow="0 40 80 0 #A0000000, 0 10 30 0 #60000000">
            <views:StartupView />
        </Border>
    </Grid>

</Window>
